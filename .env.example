# B3 Brain — Environment Variables
# copy ไฟล์นี้เป็น .env แล้วใส่ค่าจริง

# Gemini API Key (สำหรับ scripts/ask-gemini.js)
# ขอได้จาก: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase — cit-service (ดูค่าจริงใน wiki/credentials/SUPABASE-CREDENTIALS.md)
